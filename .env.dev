# TankSquare - GCP DEV Environment (`dev` Git branch)
ENV=dev
APP_NAME=TankSquare [DEV]
API_VERSION=1.0.0-dev
PORT=8080

# GCP DEV Project & Collections
GCP_PROJECT_ID=tanksquare-dev
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION_PREFIX=dev_
GCS_BUCKET_NAME=tanksquare-dev-media

# External APIs (Set in GCP Secret Manager in Cloud Run)
GOOGLE_MAPS_API_KEY=
W3W_API_KEY=
W3W_CACHE_TTL_SECONDS=3600

# DEV Sandbox Settings
ALLOWED_ORIGINS=*
REQUIRE_VENDOR_API_KEY=false
SEED_DEMO_DATA=true
