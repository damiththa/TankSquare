# TankSquare Environment & Secret Reference Template (`.env.example`)
# ============================================================================
# IMPORTANT SECURITY RULE:
# - Never commit real API keys, secrets, or `.env` / `.env.dev` / `.env.prod` files to Git.
# - In Google Cloud Run (`DEV` and `PROD`), secrets are stored in Google Cloud Secret Manager
#   and mounted at runtime via `--set-secrets` or fetched via `USE_GCP_SECRET_MANAGER=true`.
# ============================================================================

ENV=dev
APP_NAME=TankSquare
API_VERSION=1.0.0
PORT=8080

# Google Cloud Platform (Injected automatically in Cloud Run or via CI/CD)
GCP_PROJECT_ID=
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION_PREFIX=
GCS_BUCKET_NAME=
USE_GCP_SECRET_MANAGER=true

# Secrets (In GCP, stored in Secret Manager as:
#   - `tanksquare-google-maps-api-key`
#   - `tanksquare-w3w-api-key`
#   - `tanksquare-session-signing-secret`
#   - `tanksquare-vendor-api-secret`
# Leave blank here; set in Secret Manager or an untracked local `.env` file)
GOOGLE_MAPS_API_KEY=
W3W_API_KEY=
SESSION_SIGNING_SECRET=
VENDOR_API_SHARED_SECRET=

# Cache & Security Controls
W3W_CACHE_TTL_SECONDS=86400
ALLOWED_ORIGINS=*
REQUIRE_VENDOR_API_KEY=false
SEED_DEMO_DATA=true
