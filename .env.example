# TankSquare Environment Configuration Template
# Copy or select .env.dev (for `dev` branch / GCP DEV) or .env.prod (for `main` branch / GCP PROD)

ENV=dev
APP_NAME=TankSquare
API_VERSION=1.0.0
PORT=8080

# Google Cloud Platform (Direct Cloud Run + Firestore + Cloud Storage — No SQLite)
GCP_PROJECT_ID=tanksquare-dev
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION_PREFIX=dev_
GCS_BUCKET_NAME=tanksquare-dev-media

# External Geo & Grid APIs
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
W3W_API_KEY=your_what3words_api_key_here
W3W_CACHE_TTL_SECONDS=86400

# Security & Multi-Vendor Isolation
ALLOWED_ORIGINS=*
REQUIRE_VENDOR_API_KEY=false
SEED_DEMO_DATA=true
