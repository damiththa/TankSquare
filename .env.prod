# TankSquare - GCP PROD Environment (`main` Git branch)
ENV=prod
APP_NAME=TankSquare
API_VERSION=1.0.0
PORT=8080

# GCP PROD Project & Collections
GCP_PROJECT_ID=tanksquare-prod
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION_PREFIX=prod_
GCS_BUCKET_NAME=tanksquare-prod-media

# External APIs (Injected via GCP Secret Manager in Cloud Run)
GOOGLE_MAPS_API_KEY=
W3W_API_KEY=
W3W_CACHE_TTL_SECONDS=86400

# PROD Hardening Settings
ALLOWED_ORIGINS=https://*.tanksquare.com,https://*.myfuelportal.com,https://*.addsystems.com
REQUIRE_VENDOR_API_KEY=true
SEED_DEMO_DATA=false
